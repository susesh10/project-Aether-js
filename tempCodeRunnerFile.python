add_h1("APPENDIX – SOURCE CODE")
add_p(
    "The complete, functional Python source code for the Web Scraping and"
    " Product Price Analysis System is provided below:"
)

code_snippet = """import requests
from bs4 import BeautifulSoup
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import time

# 1. WEB SCRAPING
base_url = "http://books.toscrape.com/catalogue/page-{}.html"
books = []
print("Starting scraping...")

for page in range(1, 13):          # scrape first 12 pages (~240 books)
    url = base_url.format(page)
    response = requests.get(url)
    soup = BeautifulSoup(response.content, "html.parser")

    for book in soup.select("article.product_pod"):
        title = book.h3.a["title"]
        price = book.select_one("p.price_color").text.strip()
        rating = book.p["class"][1]          # One, Two, Three...
        availability = book.select_one("p.instock").text.strip()

        books.append({
            "Title": title,
            "Price": price,
            "Rating": rating,
            "Availability": availability
        })

    print(f"Page {page} done — total books so far: {len(books)}")
    time.sleep(0.5)

df_raw = pd.DataFrame(books)

# 2. CLEANING + PREPROCESSING
df = df_raw.copy()
df["Price"] = df["Price"].str.replace("£", "").astype(float)
rating_map = {"One": 1, "Two": 2, "Three": 3, "Four": 4, "Five": 5}
df["Rating"] = df["Rating"].map(rating_map)
df["Availability"] = df["Availability"].str.replace(r"[^\\d]", "", regex=True)
df["Availability"] = pd.to_numeric(df["Availability"], errors="coerce")

df = df.dropna(subset=["Title", "Price"])
df["Rating"] = df["Rating"].fillna(df["Rating"].median())
df["Availability"] = df["Availability"].fillna(0)
df = df.drop_duplicates(subset=["Title", "Price"])

# 2.6 Feature Engineering
df["Price_Range"] = pd.cut(df["Price"], bins=[0, 20, 40, 100], labels=["Low", "Mid", "High"])
df["MRP"] = (df["Price"] * 1.25).round(2)
df["Discount_%"] = (((df["MRP"] - df["Price"]) / df["MRP"]) * 100).round(1)

# 3. EXPLORATORY DATA ANALYSIS
print(df.describe())
print(df.groupby("Rating")["Price"].mean().round(2))
print(df["Price_Range"].value_counts())

# 4. VISUALISATIONS
plt.figure(figsize=(14, 10))
plt.subplot(2, 2, 1)
sns.histplot(df["Price"], bins=20, kde=True, color="steelblue")
plt.title("Price Distribution of Books", fontsize=13)

plt.subplot(2, 2, 2)
df.groupby("Rating")["Price"].mean().plot(kind="bar", color="teal", edgecolor="black")
plt.title("Average Price by Star Rating", fontsize=13)

plt.subplot(2, 2, 3)
df.groupby("Rating")["Price"].mean().plot(kind="line", marker="o", color="darkorange", linewidth=2.5)
plt.title("Average Price Trend by Rating", fontsize=13)
plt.grid(True, linestyle="--", alpha=0.7)

plt.subplot(2, 2, 4)
df["Price_Range"].value_counts().sort_index().plot(kind="bar", color="coral", edgecolor="black")
plt.title("Books by Price Range", fontsize=13)

plt.tight_layout()
plt.savefig("visualizations.png", dpi=300)
plt.show()

# 5. EXPORT
df.to_csv("cleaned_books_data.csv", index=False)
print("Cleaned data saved as cleaned_books_data.csv")"""

p_code = doc.add_paragraph()
p_code.paragraph_format.space_before = Pt(8)
p_code.paragraph_format.line_spacing = 1.15
r_code = p_code.add_run(code_snippet)
r_code.font.name = "Courier New"
r_code.font.size = Pt(8.5)
r_code.font.color.rgb = RGBColor(0, 40, 80)

output_filename = "DAE_Cornerstone_Project_Documentation.docx"
doc.save(output_filename)
print(f"Documentation successfully generated: {output_filename}")