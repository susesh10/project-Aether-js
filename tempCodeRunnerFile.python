add_h2("5.3 Preprocessing Implementation")
add_p(
    "The preprocessing steps clean currency symbols, map rating categories, and"
    " apply regular expressions to stock data:"
)
add_p(
    "df['Price'] = df['Price'].str.replace('£', '').astype(float)\n"
    "rating_map = {'One': 1, 'Two': 2, 'Three': 3, 'Four': 4, 'Five': 5}\n"
    "df['Rating'] = df['Rating'].map(rating_map)\n"
    "df['Availability'] = df['Availability'].str.replace(r'[^\\d]', '',"
    " regex=True).astype(float)\n"
    "df['Price_Range'] = pd.cut(df['Price'], bins=[0, 20, 40, 100],"
    " labels=['Low', 'Mid', 'High'])\n"
    "df['MRP'] = (df['Price'] * 1.25).round(2)\n"
    "df['Discount_%'] = (((df['MRP'] - df['Price']) / df['MRP']) *"
    " 100).round(1)"
)
for p in expand_text("vectorized preprocessing implementation details", 3):
  add_p(p)

